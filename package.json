{
  "name": "ycview",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.ycview.app",
    "productName": "YCview",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    }
  },
  "scripts": {
    "// --- Development ---------------------------": "",
    "predev": "kill-port 5173",
    "dev": "concurrently -k \"pnpm run dev:renderer\" \"pnpm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "// --- Build & Release -----------------------": "",
    "build": "pnpm run type-check && vite build && electron-builder",
    "build:dir": "pnpm run type-check && vite build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "build:all": "pnpm run build && electron-builder --win --mac --linux",
    "release": "standard-version",
    "commit": "cz",
    "// --- Quality Assurance ---------------------": "",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "// --- Utility -------------------------------": "",
    "clean": "rimraf node_modules dist out release",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,cjs,ts,tsx,json,md,css}": [
      "prettier --write"
    ],
    "*.{js,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yishow/YCview.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Yishow/YCview/issues"
  },
  "homepage": "https://github.com/Yishow/YCview#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "clsx": "^2.1.1",
    "extract-zip": "^2.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tar": "^7.5.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/archiver": "^7.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/tar": "^6.1.13",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "kill-port": "^2.0.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  }
}
